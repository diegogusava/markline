{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markline",
  "version": "0.1.0",
  "identifier": "dev.diego.markline",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Markline", "width": 1100, "height": 860, "minWidth": 520, "minHeight": 400, "dragDropEnabled": false }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico"],
    "fileAssociations": [{ "ext": ["md", "markdown"], "name": "Markdown", "role": "Editor" }] }
}
